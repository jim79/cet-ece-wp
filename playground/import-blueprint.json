{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "ECE CET import test site",
    "description": "Empty copy of the ECE CET website for trying an import of the reviewed spreadsheets. Nothing is saved.",
    "author": "jim79"
  },
  "landingPage": "/wp-admin/tools.php?page=cet-ece-import",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "siteOptions": {
    "blogname": "Department of Electronics and Communication Engineering",
    "blogdescription": "College of Engineering Trivandrum",
    "timezone_string": "Asia/Kolkata"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "secure-custom-fields"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/jim79/cet-ece-wp/main/dist/cet-ece-core.zip"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/jim79/cet-ece-wp/main/dist/cet-ece.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/import-banner.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/jim79/cet-ece-wp/main/playground/import-banner.php"
      }
    }
  ]
}
