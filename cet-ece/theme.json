{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "var(--ece-bg)" },
				{ "slug": "surface", "name": "Surface", "color": "var(--ece-surface)" },
				{ "slug": "tint", "name": "Tint", "color": "var(--ece-tint)" },
				{ "slug": "contrast", "name": "Text", "color": "var(--ece-text)" },
				{ "slug": "body", "name": "Body text", "color": "var(--ece-body)" },
				{ "slug": "muted", "name": "Muted text", "color": "var(--ece-muted)" },
				{ "slug": "line", "name": "Border", "color": "var(--ece-line)" },
				{ "slug": "accent", "name": "Accent", "color": "var(--ece-accent)" },
				{ "slug": "on-accent", "name": "Text on accent", "color": "var(--ece-on-accent)" },
				{ "slug": "link", "name": "Link", "color": "var(--ece-link)" },
				{ "slug": "hero", "name": "Hero", "color": "var(--ece-hero)" },
				{ "slug": "footer", "name": "Footer", "color": "var(--ece-foot)" },
				{ "slug": "footer-text", "name": "Footer text", "color": "var(--ece-foot-text)" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "8px" },
				{ "slug": "30", "name": "S", "size": "16px" },
				{ "slug": "40", "name": "M", "size": "24px" },
				{ "slug": "50", "name": "L", "size": "40px" },
				{ "slug": "60", "name": "XL", "size": "64px" },
				{ "slug": "70", "name": "XXL", "size": "96px" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-latin-wght-normal.woff2"] },
						{ "fontFamily": "Inter", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-latin-wght-italic.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px" },
				{ "slug": "medium", "name": "Medium", "size": "16px" },
				{ "slug": "large", "name": "Large", "size": "19px" },
				{ "slug": "x-large", "name": "Extra large", "size": "28px" },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(34px, 5vw, 56px)" }
			]
		},
		"blocks": {
			"core/button": { "border": { "radius": true } }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"spacing": {
			"blockGap": "24px",
			"padding": { "left": "24px", "right": "24px" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--link)" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "700", "letterSpacing": "-0.02em", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "clamp(32px, 4vw, 44px)", "letterSpacing": "-0.03em", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "clamp(24px, 2.6vw, 28px)" } },
			"h3": { "typography": { "fontSize": "20px" } },
			"h4": { "typography": { "fontSize": "17px" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--on-accent)" },
				"border": { "radius": "10px" },
				"spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "20px", "right": "20px" } },
				"typography": { "fontWeight": "600", "fontSize": "15px" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "14px" } }
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "15px", "fontWeight": "600" } },
			"core/post-date": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "14px" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/table": { "typography": { "fontSize": "15px" } },
			"core/quote": { "border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "3px" } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title band", "postTypes": ["page"] }
	]
}
